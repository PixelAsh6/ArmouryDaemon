{
  "spec": 1,
  "id": "g-helper",
  "name": "G-Helper",
  "version": "1.3.1",
  "order": 20,
  "targets": { "process": ["GHelper.exe"] },
  "settings": [
    {
      "key": "mode",
      "label": "Mode while a tracked app runs",
      "type": "enum",
      "values": ["Turbo", "Balanced", "Silent"],
      "default": "Turbo"
    }
  ],
  "capture": [
    {
      "key": "prev_mode",
      "mechanism": "json_file",
      "path": "%APPDATA%\\GHelper\\config.json",
      "pointer": "/performance_mode"
    },
    { "key": "was_running", "mechanism": "process_running" }
  ],
  "apply": {
    "guard": { "targetRunning": true },
    "steps": [
      {
        "mechanism": "hotkey",
        "keys_from_mode": "{{settings.mode}}",
        "map": {
          "Turbo": "ctrl+shift+alt+f18",
          "Balanced": "ctrl+shift+alt+f17",
          "Silent": "ctrl+shift+alt+f16"
        }
      }
    ]
  },
  "revert": {
    "guard": { "targetRunning": false, "capturedRunning": true },
    "steps": [
      {
        "mechanism": "hotkey",
        "keys_from_captured": "prev_mode",
        "map": {
          "0": "ctrl+shift+alt+f17",
          "1": "ctrl+shift+alt+f18",
          "2": "ctrl+shift+alt+f16"
        }
      }
    ]
  }
}
