{
  "spec": 1,
  "id": "wallpaper-engine",
  "name": "Wallpaper Engine",
  "version": "1.4.0",
  "order": 10,
  "targets": { "process": ["wallpaper64.exe", "wallpaper32.exe"] },
  "settings": [
    {
      "key": "action",
      "label": "While a tracked app runs",
      "type": "enum",
      "values": ["stop", "pause", "kill"],
      "default": "stop"
    },
    {
      "key": "binary",
      "label": "Which Wallpaper Engine binary to call",
      "type": "enum",
      "values": ["auto", "64-bit", "32-bit"],
      "default": "auto"
    }
  ],
  "capture": [
    { "key": "was_running", "mechanism": "process_running" },
    { "key": "target_path", "mechanism": "target_path" }
  ],
  "apply": {
    "guard": { "targetRunning": true },
    "steps": [
      { "mechanism": "cli", "exe_from_setting": "binary",
        "exe_map": {
          "auto": "{{captured.target_path}}",
          "64-bit": "{{target.dir}}\\wallpaper64.exe",
          "32-bit": "{{target.dir}}\\wallpaper32.exe"
        },
        "args": ["-control", "stop"],
        "when": { "source": "setting", "equals": "stop" } },
      { "mechanism": "cli", "exe_from_setting": "binary",
        "exe_map": {
          "auto": "{{captured.target_path}}",
          "64-bit": "{{target.dir}}\\wallpaper64.exe",
          "32-bit": "{{target.dir}}\\wallpaper32.exe"
        },
        "args": ["-control", "pause"],
        "when": { "source": "setting", "equals": "pause" } },
      { "mechanism": "process_kill", "exe": "{{captured.target_path}}",
        "when": { "source": "setting", "equals": "kill" } }
    ]
  },
  "revert": {
    "guard": { "targetRunning": false, "capturedRunning": true },
    "steps": [
      { "mechanism": "process_start", "exe": "{{captured.target_path}}",
        "when": { "source": "setting", "equals": "kill" } },
      { "mechanism": "cli", "exe_from_setting": "binary",
        "exe_map": {
          "auto": "{{captured.target_path}}",
          "64-bit": "{{target.dir}}\\wallpaper64.exe",
          "32-bit": "{{target.dir}}\\wallpaper32.exe"
        },
        "args": ["-control", "play"],
        "when": { "source": "setting", "not_equals": "kill" } },
      { "mechanism": "cli", "exe_from_setting": "binary",
        "exe_map": {
          "auto": "{{captured.target_path}}",
          "64-bit": "{{target.dir}}\\wallpaper64.exe",
          "32-bit": "{{target.dir}}\\wallpaper32.exe"
        },
        "args": ["-control", "play"],
        "sleep_ms": 2500,
        "when": { "source": "setting", "equals": "kill" } }
    ]
  }
}
